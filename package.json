{
  "name": "vibeprint",
  "version": "0.1.0",
  "description": "MCP server that discovers your developer profile and generates a personal brand roadmap, content topics, and tweet copy.",
  "keywords": [
    "mcp",
    "personal-brand",
    "twitter",
    "github",
    "content-calendar",
    "X",
    "vibe-code",
    "claude-code",
    "codex",
    "cli"
  ],
  "author": "Efecan Basoz <efecan@sirkhet.com>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vibeprint": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.14.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
